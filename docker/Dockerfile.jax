# Use a specific, tagged JAX base image for reproducibility
FROM ghcr.io/nvidia/jax:maxtext-2026-04-29

# Set environment variables for logging and system configuration
ENV FLUXWAY_LOG_LEVEL=WARNING \
    FLUXWAY_LOG_FORCE=TRUE \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Configure APT sources for faster mirroring
ARG APT_MIRROR=archive.ubuntu.com
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_MIRROR=https://mirrors.aliyun.com/pypi/simple/
RUN chmod 1777 /tmp && \
    sed -i "s@http://archive.ubuntu.com/ubuntu/@http://${APT_MIRROR}/ubuntu/@g" /etc/apt/sources.list.d/ubuntu.sources && \
    sed -i "s@http://security.ubuntu.com/ubuntu/@http://${APT_MIRROR}/ubuntu/@g" /etc/apt/sources.list.d/ubuntu.sources

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    vim \
    wget \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://get.perfetto.dev/trace_processor -o /tmp/trace_processor && \
    python3 /tmp/trace_processor --version && \
    install -m 0755 "$(find /root/.local/share/perfetto/prebuilts -type f -name 'trace_processor_shell-*' -print -quit)" /usr/local/bin/trace_processor_shell && \
    rm -rf /tmp/trace_processor /root/.local/share/perfetto && \
    trace_processor_shell --version

# Configure pip index mirrors for faster resolution
RUN pip config set global.index-url ${PIP_INDEX_URL} && \
    pip config set global.extra-index-url ${PIP_MIRROR} && \
    pip config set global.trusted-host "$(echo ${PIP_INDEX_URL} | awk -F[/:] '{print $4}') $(echo ${PIP_MIRROR} | awk -F[/:] '{print $4}')"

# Set the working directory
WORKDIR /workspace

# Install common Python dependencies required by the project
# pylance is not a vscode plugin, it's lance-format
RUN pip install --default-timeout=1000 --no-cache-dir \
    boto3 \
    chex \
    Cython \
    grain \
    libclang \
    minio \
    numba \
    orjson \
    psutil \
    flask \
    pandas \
    "pyarrow>=14.0" \
    pydantic \
    pylance \
    "pyiceberg[sql-postgres,s3,glue,hive,pyarrow]" \
    ray[all] \
    rich \
    s3fs \
    scikit-learn \
    tyro \
    vortex-data \
    fastparquet

# Remove conflicting cupy-cuda12x installed by ray before installing RAPIDS to prevent breaking the cupy installation
RUN pip uninstall -y cupy-cuda12x

# Install RAPIDS GPU-accelerated libraries
RUN pip install --default-timeout=1000 --no-cache-dir --extra-index-url https://pypi.nvidia.com cudf-cu13 rmm-cu13

# Copy project files into the container
# NOTE: Ensure you run `docker build` from the repository root, e.g.:
# docker build -t fluxway -f docker/Dockerfile .
COPY . /workspace/

# Install Fluxway core, JAX, profiling, and graph visualization dependencies
RUN cd /workspace && \
    pip install --default-timeout=1000 --no-cache-dir -e ".[jax,profiler,visualization]"

# Default command
CMD ["/bin/bash"]
